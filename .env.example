# VeloScore Sports Live Scores - Environment Configuration
# Copy this file to .env or configure in Cloudflare dashboard

# Application Environment
NODE_ENV=production
APP_URL=https://veloscore.live

# Sports Data Provider Configuration
# Options: 'mock' (default offline demo mode) | 'api-football' | 'sportmonks'
SPORTS_PROVIDER=mock

# Sports Provider API Key (Keep server-side only; never expose to client bundle)
# Get credentials from https://www.api-football.com/ or https://www.sportmonks.com/
SPORTS_API_KEY=

# Google AdSense Monetization
# Replace with your approved 16-digit Google AdSense Publisher ID (e.g. pub-1234567890123456)
ADSENSE_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX

# Cloudflare D1 & Workers Configuration
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=

# AI Studio Injection
GEMINI_API_KEY=
